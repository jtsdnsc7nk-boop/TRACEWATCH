# Copy this file to .env.local and fill in what you have. Every key is optional:
# TraceWatch works without any of them.

# Discord bot token: profile lookups go straight to Discord instead of the public japi.rest mirror.
DISCORD_BOT_TOKEN=

# Have I Been Pwned API key (https://haveibeenpwned.com/API/Key): adds HIBP account search and paste data.
HIBP_API_KEY=
